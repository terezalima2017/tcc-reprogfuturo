# ===========================================
# Configuração do Ambiente - ReProgFuturo
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Ambiente
NODE_ENV=development
PORT=3000

# ===== BANCO DE DADOS =====
# Opção 1: URL de conexão (recomendado para Neon PostgreSQL em produção)
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Opção 2: Variáveis individuais (PostgreSQL)
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=reprogfuturo
# DB_USER=
# DB_PASS=

# Opção 3: SQLite (desenvolvimento local)
DB_STORAGE=./database.sqlite

# ===== SESSÃO =====
SESSION_SECRET=troque-por-uma-chave-segura-aleatoria

# ===== CLOUDINARY (Hospedagem de Imagens) =====
# Opção 1: URL completa (encontrada no dashboard do Cloudinary)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Opção 2: Variáveis individuais
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ===== ADMINISTRADOR PADRÃO =====
# (obrigatório para criar o admin no seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
