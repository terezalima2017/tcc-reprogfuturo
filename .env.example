# ===========================================
# Configuração do Ambiente - ReProgFuturo
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Ambiente
NODE_ENV=development
PORT=3000

# Banco de Dados (PostgreSQL - produção)
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=reprogfuturo
# DB_USER=
# DB_PASS=

# Banco de Dados (SQLite - desenvolvimento)
DB_STORAGE=./database.sqlite

# Sessão
SESSION_SECRET=troque-por-uma-chave-segura-aleatoria

# Administrador Padrão (obrigatório para criar o admin no seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
