<div class="container py-4 fade-in-up">
  <h2 class="fw-bold mb-4"><i class="bi bi-person me-2"></i>Meu Perfil</h2>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="eco-card text-center p-4">
        <div style="font-size:4rem;">👤</div>
        <h4 class="fw-bold mt-2">{{aluno.nome}}</h4>
        <p class="text-muted">{{aluno.email}}</p>
        <div class="stat-card mt-3">
          <div class="stat-icon">⭐</div>
          <div class="stat-number">{{aluno.pontuacaoAcumulada}}</div>
          <div class="stat-label">Pontos Acumulados</div>
        </div>
        {{#if matricula}}
        <div class="mt-3 p-3 rounded" style="background:#f0faf0;">
          <strong>Turma:</strong> {{matricula.turma.nome}}
        </div>
        {{/if}}
        <div class="mt-3 p-3 rounded" style="background:#f8f9fa;">
          <strong>Atividades Realizadas:</strong> {{totalAtividades}}<br>
          <strong>Pontuação Média:</strong> {{pontuacaoMedia}}
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <div class="eco-card">
        <div class="card-header"><i class="bi bi-clock-history me-2"></i>Histórico de Atividades</div>
        <div class="card-body">
          {{#if respostas.length}}
          {{#each respostas}}
          <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded" style="background:#f8f9fa;">
            <div>
              <span class="badge badge-tipo badge-{{this.atividade.tipo}} me-2">{{tipoAtividadeLabel this.atividade.tipo}}</span>
              <strong>{{this.atividade.nome}}</strong>
              <small class="d-block text-muted ms-5">{{formatDate this.updatedAt}}</small>
            </div>
            <div class="text-center">
              <span style="font-size:1.5rem;">{{feedbackEmoji this.pontuacao}}</span>
              <div class="fw-bold" style="color:#2D6A4F;">{{this.pontuacao}} pts</div>
            </div>
          </div>
          {{/each}}
          {{else}}
          <p class="text-muted text-center py-3">Nenhuma atividade realizada ainda.</p>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>
