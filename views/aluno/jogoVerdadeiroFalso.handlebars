<div class="container py-4 fade-in-up">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">✅ {{atividade.nome}}</h2>
      <p class="text-muted mb-0">{{atividade.descricao}}</p>
    </div>
    <a href="/aluno/atividades" class="btn btn-eco-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
  </div>

  <div class="text-center mb-3">
    <span class="badge bg-eco p-2 fs-6" id="progresso">Pergunta 1 de {{atividade.afirmacoes.length}}</span>
  </div>

  <div id="vfContainer"></div>

  <div id="resultContainer" class="text-center mt-4" style="display:none;">
    <button id="btnFinalizar" class="btn btn-eco btn-lg"><i class="bi bi-check-lg me-2"></i>Ver Resultado</button>
  </div>
</div>

{{> feedbackModal}}

<script>
const afirmacoes = {{{afirmacoesJSON}}};
const atividadeId = '{{atividade.id}}';
const turmaId = '{{turmaId}}';
const respostas = {};
let atual = 0;

function renderPergunta() {
  if (atual >= afirmacoes.length) {
    document.getElementById('vfContainer').innerHTML = `
      <div class="vf-card">
        <div style="font-size:3rem;">🎉</div>
        <h4 class="mt-2 fw-bold">Você respondeu todas!</h4>
        <p class="text-muted">Clique em "Ver Resultado" para ver sua pontuação.</p>
      </div>
    `;
    document.getElementById('resultContainer').style.display = 'block';
    return;
  }

  const af = afirmacoes[atual];
  document.getElementById('progresso').textContent = `Pergunta ${atual + 1} de ${afirmacoes.length}`;

  document.getElementById('vfContainer').innerHTML = `
    <div class="vf-card">
      <div class="mb-3"><span class="badge bg-eco">${atual + 1}/${afirmacoes.length}</span></div>
      <p class="vf-afirmacao">"${af.afirmacao}"</p>
      <div class="d-flex gap-3 justify-content-center">
        <button class="btn-verdadeiro" id="btnVerdadeiro">
          <i class="bi bi-check-lg me-1"></i>Verdadeiro
        </button>
        <button class="btn-falso" id="btnFalso">
          <i class="bi bi-x-lg me-1"></i>Falso
        </button>
      </div>
    </div>
  `;

  document.getElementById('btnVerdadeiro').addEventListener('click', function() {
    responder(af.id, true);
  });
  document.getElementById('btnFalso').addEventListener('click', function() {
    responder(af.id, false);
  });
}

function responder(id, valor) {
  respostas[id] = valor;

  const container = document.getElementById('vfContainer');
  const card = container.querySelector('.vf-card');

  // Set a neutral border indicating answer registered
  card.style.borderLeft = '4px solid #6c757d';

  // Highlight selected button, dim the other
  const btnVerdadeiro = document.getElementById('btnVerdadeiro');
  const btnFalso = document.getElementById('btnFalso');

  if (valor === true) {
    btnVerdadeiro.style.transform = 'scale(1.05)';
    btnVerdadeiro.style.boxShadow = '0 0 10px rgba(76, 175, 80, 0.5)';
    btnFalso.style.opacity = '0.4';
  } else {
    btnFalso.style.transform = 'scale(1.05)';
    btnFalso.style.boxShadow = '0 0 10px rgba(244, 67, 54, 0.5)';
    btnVerdadeiro.style.opacity = '0.4';
  }

  // Disable buttons
  btnVerdadeiro.disabled = true;
  btnFalso.disabled = true;

  card.insertAdjacentHTML('beforeend', '<p class="mt-2 text-muted fw-bold">Resposta registrada!</p>');

  setTimeout(() => {
    atual++;
    renderPergunta();
  }, 800);
}

document.getElementById('btnFinalizar').addEventListener('click', async function() {
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';
  try {
    const resp = await fetch(`/aluno/atividades/${atividadeId}/responder`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ respostas, turmaId })
    });
    const data = await resp.json();
    if (data.sucesso) mostrarFeedback(data.pontuacao, data.feedback);
  } catch (err) {
    alert('Erro ao enviar.');
    this.disabled = false;
  }
});

renderPergunta();
</script>
