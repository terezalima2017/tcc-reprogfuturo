<div class="container py-4 fade-in-up">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">🔍 {{atividade.nome}}</h2>
      <p class="text-muted mb-0">{{atividade.descricao}}</p>
    </div>
    <a href="/aluno/atividades" class="btn btn-eco-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="eco-card">
        <div class="card-header text-center">
          <h5 class="mb-0 fw-bold">Encontre as palavras na grade!</h5>
        </div>
        <div class="card-body text-center">
          <div id="gridContainer" class="word-search-grid" style="grid-template-columns: repeat(15, 1fr);"></div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="eco-card">
        <div class="card-header"><i class="bi bi-list-check me-2"></i>Palavras (<span id="encontradasCount">0</span>/{{atividade.palavras.length}})</div>
        <div class="card-body">
          <div id="wordList"></div>
          <div id="resultContainer" class="mt-3" style="display:none;">
            <button id="btnFinalizar" class="btn btn-eco w-100"><i class="bi bi-check-lg me-2"></i>Finalizar</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{> feedbackModal}}

<script>
const grade = {{{gradeJSON}}};
const palavras = {{{palavrasJSON}}};
const atividadeId = '{{atividade.id}}';
const turmaId = '{{turmaId}}';
const encontradas = [];
let selecionando = false;
let celsSelecionadas = [];

const gridContainer = document.getElementById('gridContainer');
const wordListContainer = document.getElementById('wordList');

// Renderizar grade
grade.forEach((row, r) => {
  row.forEach((letra, c) => {
    const cell = document.createElement('div');
    cell.className = 'word-search-cell';
    cell.textContent = letra;
    cell.dataset.row = r;
    cell.dataset.col = c;

    cell.addEventListener('mousedown', (e) => {
      e.preventDefault();
      selecionando = true;
      celsSelecionadas = [cell];
      cell.classList.add('selected');
    });

    cell.addEventListener('mouseenter', () => {
      if (selecionando) {
        celsSelecionadas.push(cell);
        cell.classList.add('selected');
      }
    });

    gridContainer.appendChild(cell);
  });
});

document.addEventListener('mouseup', () => {
  if (!selecionando) return;
  selecionando = false;

  const palavra = celsSelecionadas.map(c => c.textContent).join('');
  const palavraRev = palavra.split('').reverse().join('');

  let found = false;
  for (const p of palavras) {
    if ((palavra.toUpperCase() === p || palavraRev.toUpperCase() === p) && !encontradas.includes(p)) {
      encontradas.push(p);
      celsSelecionadas.forEach(c => {
        c.classList.remove('selected');
        c.classList.add('found');
      });
      found = true;
      atualizarWordList();
      break;
    }
  }

  if (!found) {
    celsSelecionadas.forEach(c => c.classList.remove('selected'));
  }
  celsSelecionadas = [];
});

// Renderizar lista de palavras
function atualizarWordList() {
  wordListContainer.innerHTML = '';
  palavras.forEach(p => {
    const span = document.createElement('span');
    span.className = 'word-list-item' + (encontradas.includes(p) ? ' found' : '');
    span.textContent = p;
    wordListContainer.appendChild(span);
  });
  document.getElementById('encontradasCount').textContent = encontradas.length;

  if (encontradas.length >= palavras.length) {
    document.getElementById('resultContainer').style.display = 'block';
  }
}

atualizarWordList();

// Permitir finalizar mesmo sem encontrar todas
setTimeout(() => {
  document.getElementById('resultContainer').style.display = 'block';
}, 30000);

document.getElementById('btnFinalizar').addEventListener('click', async function() {
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';
  try {
    const resp = await fetch(`/aluno/atividades/${atividadeId}/responder`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ respostas: { encontradas }, turmaId })
    });
    const data = await resp.json();
    if (data.sucesso) mostrarFeedback(data.pontuacao, data.feedback);
  } catch (err) {
    alert('Erro ao enviar.');
    this.disabled = false;
  }
});
</script>
