<!-- Modal de Feedback -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content eco-modal">
      <div class="modal-body text-center py-5">
        <div class="feedback-emoji" id="feedbackEmoji"></div>
        <h3 class="mt-3" id="feedbackPontuacao"></h3>
        <p class="feedback-mensagem mt-2" id="feedbackMensagem"></p>
        <div class="progress mt-4 mx-auto" style="max-width: 300px; height: 20px;">
          <div class="progress-bar" id="feedbackBarra" role="progressbar" style="width: 0%"></div>
        </div>
        <button type="button" class="btn btn-eco mt-4" data-bs-dismiss="modal" onclick="window.location.href='/aluno/atividades'">
          <i class="bi bi-arrow-left me-1"></i> Voltar às Atividades
        </button>
      </div>
    </div>
  </div>
</div>
