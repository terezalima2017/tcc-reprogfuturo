<div class="container py-4 fade-in-up">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-graph-up me-2"></i>Relatório: {{turma.nome}}</h2>
    <a href="/professor/relatorios" class="btn btn-eco-secondary"><i class="bi bi-arrow-left me-2"></i>Voltar</a>
  </div>

  <!-- Painel de Dados da Escola (obrigatório para liberar certificados) -->
  <div class="eco-card mb-4 {{#unless turma.escola}}border border-2 border-warning{{/unless}}">
    <div class="card-header d-flex align-items-center gap-2">
      <i class="bi bi-building me-1"></i>Dados da Escola para Certificados
      {{#if turma.escola}}
        <span class="badge bg-success ms-auto"><i class="bi bi-check-circle me-1"></i>Escola confirmada</span>
      {{else}}
        <span class="badge bg-warning text-dark ms-auto"><i class="bi bi-exclamation-triangle me-1"></i>Pendente — obrigatório</span>
      {{/if}}
    </div>
    <div class="card-body">
      {{#if turma.escola}}
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <span class="text-muted small">Nome da escola registrada:</span>
            <p class="fw-bold fs-6 mb-0 mt-1"><i class="bi bi-building me-2 text-success"></i>{{turma.escola}}</p>
          </div>
          <button class="btn btn-eco-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#formEditarEscola">
            <i class="bi bi-pencil me-1"></i>Alterar
          </button>
        </div>
        <div class="collapse mt-3" id="formEditarEscola">
          <form action="/professor/turmas/{{turma.id}}/escola" method="POST" class="eco-form">
            <div class="input-group">
              <input type="text" class="form-control" name="escola" placeholder="Nome completo da escola" value="{{turma.escola}}" required minlength="3">
              <button type="submit" class="btn btn-eco"><i class="bi bi-check-lg me-1"></i>Salvar</button>
            </div>
          </form>
        </div>
      {{else}}
        <div class="alert alert-warning mb-3 d-flex gap-2 align-items-start">
          <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
          <div>
            <strong>Ação necessária:</strong> O nome da escola é <strong>obrigatório</strong> para a emissão dos certificados. Preencha abaixo antes de liberar qualquer certificado.
          </div>
        </div>
        <form action="/professor/turmas/{{turma.id}}/escola" method="POST" class="eco-form">
          <div class="mb-3">
            <label for="escola" class="form-label fw-semibold">Nome completo da escola <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-building"></i></span>
              <input type="text" class="form-control form-control-lg" id="escola" name="escola"
                placeholder="Ex: E.M.E.F. Professora Maria da Silva" required minlength="3">
              <button type="submit" class="btn btn-eco"><i class="bi bi-check-lg me-1"></i>Confirmar</button>
            </div>
            <div class="form-text">Este nome aparecerá em todos os certificados desta turma.</div>
          </div>
        </form>
      {{/if}}
    </div>
  </div>

  <div class="eco-card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <p class="mb-1"><strong>Total de atividades da turma:</strong> {{totalAtividadesTurma}}</p>
        <p class="mb-0"><strong>Total de alunos:</strong> {{relatorio.length}}</p>
      </div>
      {{#if relatorio.length}}
      {{#if turma.escola}}
      <form action="/professor/turmas/{{turma.id}}/certificados/liberar-todos" method="POST"
        onsubmit="return confirm('Deseja liberar o certificado para todos os alunos da turma?')">
        <button type="submit" class="btn btn-eco">
          <i class="bi bi-award-fill me-2"></i>Liberar Certificados para Todos
        </button>
      </form>
      {{else}}
      <button class="btn btn-outline-warning" disabled title="Informe o nome da escola primeiro">
        <i class="bi bi-lock me-2"></i>Liberar para Todos (bloqueado)
      </button>
      {{/if}}
      {{/if}}
    </div>
  </div>

  {{#if relatorio.length}}
  <div class="table-responsive">
    <table class="table eco-table">
      <thead>
        <tr>
          <th>Aluno</th>
          <th>Pontuação Acumulada</th>
          <th>Atividades Realizadas</th>
          <th>Total Atividades</th>
          <th>Pontuação Média</th>
          <th>Participação</th>
          <th class="text-center">Certificado</th>
        </tr>
      </thead>
      <tbody>
        {{#each relatorio}}
        <tr>
          <td>
            <strong>{{this.nome}}</strong>
            <small class="d-block text-muted">{{this.email}}</small>
          </td>
          <td><span class="fw-bold">{{this.pontuacaoAcumulada}}</span> pts</td>
          <td>{{this.atividadesRealizadas}}</td>
          <td>{{this.totalAtividadesTurma}}</td>
          <td>
            <span class="fw-bold" style="color: {{#if (gte this.pontuacaoMedia 70)}}#2E7D32{{else if (gte this.pontuacaoMedia 50)}}#F57F17{{else}}#D32F2F{{/if}}">
              {{this.pontuacaoMedia}}
            </span>
          </td>
          <td>
            <div class="d-flex align-items-center gap-2">
              <div class="progress flex-grow-1" style="height:20px;">
                <div class="progress-bar" style="width:{{this.participacao}}%">{{this.participacao}}%</div>
              </div>
            </div>
          </td>
          <td class="text-center">
            {{#if this.certificadoLiberado}}
              <div class="d-flex flex-column align-items-center gap-1">
                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Liberado</span>
                <a href="/professor/turmas/{{../turma.id}}/certificados/{{this.id}}/download" class="btn btn-sm btn-outline-success py-0 px-2 mt-1">
                  <i class="bi bi-download me-1"></i>PDF
                </a>
              </div>
            {{else}}
              {{#if ../turma.escola}}
              <form action="/professor/turmas/{{../turma.id}}/certificados/{{this.id}}/liberar" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm {{#if this.concluiuTodas}}btn-eco{{else}}btn-outline-secondary{{/if}}">
                  <i class="bi bi-award me-1"></i>Liberar
                </button>
              </form>
              {{#if this.concluiuTodas}}
                <small class="d-block text-success mt-1"><i class="bi bi-check2"></i> Concluiu atividades</small>
              {{/if}}
              {{else}}
              <span class="badge bg-secondary" title="Informe o nome da escola primeiro">
                <i class="bi bi-lock me-1"></i>Bloqueado
              </span>
              {{/if}}
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="eco-card text-center p-5">
    <p class="text-muted">Nenhum aluno matriculado nesta turma.</p>
  </div>
  {{/if}}
</div>
