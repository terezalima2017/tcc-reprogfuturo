<div class="container py-4 fade-in-up">
  <h2 class="fw-bold mb-4"><i class="bi bi-graph-up me-2"></i>Relatórios de Desempenho</h2>
  {{#if turmas.length}}
  <div class="row g-4">
    {{#each turmas}}
    <div class="col-md-6 col-lg-4">
      <a href="/professor/relatorios/turma/{{this.id}}" class="text-decoration-none">
        <div class="eco-card text-center p-4 h-100">
          <div style="font-size:2rem;">📊</div>
          <h5 class="fw-bold mt-2" style="color:#2D6A4F;">{{this.nome}}</h5>
          <p class="text-muted small mb-0">{{this.matriculas.length}} alunos</p>
        </div>
      </a>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="eco-card text-center p-5">
    <p class="text-muted">Nenhuma turma para gerar relatórios.</p>
  </div>
  {{/if}}
</div>
