<div class="container py-4 fade-in-up">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>Minhas Turmas</h2>
    <a href="/professor/turmas/criar" class="btn btn-eco"><i class="bi bi-plus-lg me-2"></i>Nova Turma</a>
  </div>
  {{#if turmas.length}}
  <div class="row g-4">
    {{#each turmas}}
    <div class="col-md-6 col-lg-4">
      <div class="eco-card h-100 d-flex flex-column">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-bold">{{this.nome}}</span>
          <span class="badge bg-eco">{{this.matriculas.length}} alunos</span>
        </div>
        <div class="card-body text-center d-flex flex-column justify-content-between">
          <div>
            <div class="turma-codigo mb-3">
              <span class="code">{{this.codigo}}</span>
              <button class="btn-copy" data-code="{{this.codigo}}" title="Copiar"><i class="bi bi-clipboard"></i></button>
            </div>
            <p class="small text-muted mb-2">Compartilhe o código acima com seus alunos</p>
            <p class="small mb-3">
              <i class="bi bi-building me-1 text-success"></i>
              {{#if this.escola}}
                <strong>{{this.escola}}</strong>
              {{else}}
                <span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Escola não informada</span>
              {{/if}}
            </p>
          </div>
          <div class="d-grid gap-2">
            <a href="/professor/turmas/{{this.id}}" class="btn btn-eco-secondary btn-sm">
              <i class="bi bi-eye me-1"></i>Ver Detalhes
            </a>
            <a href="/professor/relatorios/turma/{{this.id}}" class="btn btn-eco btn-sm">
              <i class="bi bi-award me-1"></i>Relatório e Certificados
            </a>
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="eco-card text-center p-5">
    <div style="font-size: 3rem;">🏫</div>
    <h5 class="mt-3 fw-bold">Nenhuma turma criada</h5>
    <p class="text-muted">Crie sua primeira turma para começar!</p>
    <a href="/professor/turmas/criar" class="btn btn-eco"><i class="bi bi-plus-lg me-2"></i>Criar Turma</a>
  </div>
  {{/if}}
</div>
