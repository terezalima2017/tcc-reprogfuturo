<div class="container py-4 fade-in-up">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-clipboard-check me-2"></i>Avaliar Desafio</h2>
    <a href="/professor/desafios/avaliar" class="btn btn-eco-secondary"><i class="bi bi-arrow-left me-2"></i>Voltar</a>
  </div>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="eco-card h-100">
        <div class="card-header"><i class="bi bi-info-circle me-2"></i>Informações</div>
        <div class="card-body">
          <p><strong>Aluno:</strong> {{evidencia.respostaAtividade.aluno.nome}}</p>
          <p><strong>Email:</strong> {{evidencia.respostaAtividade.aluno.email}}</p>
          <p><strong>Atividade:</strong> {{evidencia.respostaAtividade.atividade.nome}}</p>
          <p><strong>Turma:</strong> {{evidencia.respostaAtividade.turma.nome}}</p>
          <p><strong>Data de envio:</strong> {{formatDateTime evidencia.createdAt}}</p>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="eco-card h-100">
        <div class="card-header"><i class="bi bi-camera me-2"></i>Fotos Enviadas</div>
        <div class="card-body">
          {{#if evidencia.fotoUrl}}
          <img src="{{evidencia.fotoUrl}}" alt="Evidência" class="img-fluid rounded mb-2" style="max-height: 300px;">
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  <div class="eco-card my-4">
    <div class="card-header"><i class="bi bi-journal-text me-2"></i>Relatório do Aluno</div>
    <div class="card-body">
      <p>{{evidencia.relatorio}}</p>
    </div>
  </div>

  <div class="eco-card">
    <div class="card-header"><i class="bi bi-check2-square me-2"></i>Avaliação</div>
    <div class="card-body">
      <form action="/professor/desafios/{{evidencia.id}}/avaliar" method="POST" class="eco-form">
        <div class="mb-3">
          <label class="form-label">Feedback (opcional)</label>
          <textarea class="form-control" name="feedbackProfessor" rows="3" placeholder="Deixe um comentário para o aluno..."></textarea>
        </div>
        <div class="d-flex gap-3">
          <button type="submit" name="status" value="aprovado" class="btn btn-success btn-lg flex-fill">
            <i class="bi bi-check-circle me-2"></i>Aprovar (100 pts)
          </button>
          <button type="submit" name="status" value="rejeitado" class="btn btn-eco-danger btn-lg flex-fill">
            <i class="bi bi-x-circle me-2"></i>Não Realizado (0 pts)
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
