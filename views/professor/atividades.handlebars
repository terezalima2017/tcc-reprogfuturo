<div class="container py-4 fade-in-up">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-controller me-2"></i>Minhas Atividades</h2>
    <a href="/professor/atividades/criar" class="btn btn-eco"><i class="bi bi-plus-lg me-2"></i>Nova Atividade</a>
  </div>

  {{#if atividades.length}}
  <div class="row g-4 mb-5">
    {{#each atividades}}
    <div class="col-md-6 col-lg-4">
      <div class="eco-card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="badge badge-tipo badge-{{this.tipo}}">{{tipoAtividadeLabel this.tipo}}</span>
          <small class="text-muted">{{formatDate this.createdAt}}</small>
        </div>
        <div class="card-body">
          <h5 class="fw-bold">{{this.nome}}</h5>
          <p class="text-muted small">{{this.descricao}}</p>
          <div class="d-flex gap-2 flex-wrap">
            <a href="/professor/atividades/{{this.id}}" class="btn btn-eco-secondary btn-sm"><i class="bi bi-eye me-1"></i>Ver</a>
            <a href="/professor/atividades/{{this.id}}/associar" class="btn btn-eco btn-sm"><i class="bi bi-link-45deg me-1"></i>Associar</a>
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="eco-card text-center p-5 mb-5">
    <div style="font-size: 3rem;">🎮</div>
    <h5 class="mt-3 fw-bold">Nenhuma atividade criada</h5>
    <p class="text-muted">Crie sua primeira atividade ambiental!</p>
    <a href="/professor/atividades/criar" class="btn btn-eco"><i class="bi bi-plus-lg me-2"></i>Criar Atividade</a>
  </div>
  {{/if}}

  {{#if templates.length}}
  <h3 class="fw-bold mb-3"><i class="bi bi-collection me-2"></i>Atividades Prontas (do Admin)</h3>
  <div class="row g-4">
    {{#each templates}}
    <div class="col-md-6 col-lg-4">
      <div class="eco-card h-100" style="border-left: 4px solid #F9A825;">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="badge badge-tipo badge-{{this.tipo}}">{{tipoAtividadeLabel this.tipo}}</span>
          <span class="badge bg-warning text-dark">Template</span>
        </div>
        <div class="card-body">
          <h5 class="fw-bold">{{this.nome}}</h5>
          <p class="text-muted small">{{this.descricao}}</p>
          <a href="/professor/atividades/{{this.id}}/associar" class="btn btn-eco btn-sm"><i class="bi bi-link-45deg me-1"></i>Usar em Turma</a>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>
