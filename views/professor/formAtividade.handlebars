<div class="container py-4 fade-in-up">
  <h2 class="fw-bold mb-4"><i class="bi bi-plus-circle me-2"></i>{{#if editando}}Editar Atividade{{else}}Criar Atividade{{/if}}</h2>

  <div class="eco-card">
    <div class="card-body">
      <form action="{{#if editando}}/professor/atividades/{{atividade.id}}{{else}}/professor/atividades{{/if}}" method="POST" enctype="multipart/form-data" class="eco-form">
        <div class="mb-3">
          <label for="nome" class="form-label">Nome da Atividade *</label>
          <input type="text" class="form-control" id="nome" name="nome" value="{{#if editando}}{{atividade.nome}}{{/if}}" required placeholder="Ex: Reciclagem no Dia a Dia">
        </div>

        <div class="mb-3">
          <label for="descricao" class="form-label">Descrição *</label>
          <textarea class="form-control" id="descricao" name="descricao" rows="3" required placeholder="Descreva a atividade...">{{#if editando}}{{atividade.descricao}}{{/if}}</textarea>
        </div>

        {{#unless editando}}
        <div class="mb-3">
          <label for="tipo" class="form-label">Tipo de Atividade *</label>
          <select class="form-select" id="tipo" name="tipo" required>
            <option value="">Selecione o tipo</option>
            <option value="lixo_misterioso">🗑️ Lixo Misterioso</option>
            <option value="caca_palavras">🔍 Caça-Palavras</option>
            <option value="verdadeiro_falso">✅ Verdadeiro ou Falso</option>
            <option value="multipla_escolha">📝 Múltipla Escolha</option>
            <option value="desafio_diario">🌟 Desafio Diário</option>
          </select>
        </div>
        {{/unless}}

        <div class="mb-4">
          <label for="imagem" class="form-label">Imagem (opcional)</label>
          <input type="file" class="form-control" id="imagem" name="imagem" accept="image/*">
          {{#if editando}}{{#if atividade.imagemUrl}}<small class="text-muted">Imagem atual: {{atividade.imagemUrl}}</small>{{/if}}{{/if}}
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-eco"><i class="bi bi-check-lg me-2"></i>{{#if editando}}Salvar{{else}}Criar Atividade{{/if}}</button>
          <a href="/professor/atividades" class="btn btn-eco-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
