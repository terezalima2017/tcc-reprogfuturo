<div class="container py-4 fade-in-up">
  <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2"></i>Painel Administrativo</h2>
  <p class="text-muted mb-4">Gerencie as atividades prontas do sistema 🌍</p>

  <div class="row g-4 mb-4">
    <div class="col-md-3 col-6">
      <div class="stat-card"><div class="stat-icon">👥</div><div class="stat-number">{{totalUsuarios}}</div><div class="stat-label">Usuários</div></div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card"><div class="stat-icon">🎒</div><div class="stat-number">{{totalAlunos}}</div><div class="stat-label">Alunos</div></div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card"><div class="stat-icon">📚</div><div class="stat-number">{{totalProfessores}}</div><div class="stat-label">Professores</div></div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card"><div class="stat-icon">🎯</div><div class="stat-number">{{totalTemplates}}</div><div class="stat-label">Templates</div></div>
    </div>
  </div>

  <div class="eco-card text-center p-4">
    <h5 class="fw-bold">Gerenciar Atividades Prontas</h5>
    <p class="text-muted">Crie atividades reutilizáveis que os professores poderão usar nas suas turmas.</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
      <a href="/admin/atividades" class="btn btn-eco"><i class="bi bi-collection me-2"></i>Ver Atividades</a>
      <a href="/admin/atividades/criar" class="btn btn-eco-secondary"><i class="bi bi-plus-lg me-2"></i>Criar Nova</a>
    </div>
  </div>
</div>
