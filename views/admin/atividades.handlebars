<div class="container py-4 fade-in-up">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-collection me-2"></i>Atividades Prontas</h2>
    <a href="/admin/atividades/criar" class="btn btn-eco"><i class="bi bi-plus-lg me-2"></i>Criar Template</a>
  </div>

  {{#if atividades.length}}
  <div class="row g-4">
    {{#each atividades}}
    <div class="col-md-6 col-lg-4">
      <div class="eco-card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="badge badge-tipo badge-{{this.tipo}}">{{tipoAtividadeLabel this.tipo}}</span>
          <span class="badge bg-warning text-dark">Template</span>
        </div>
        <div class="card-body">
          <h5 class="fw-bold">{{this.nome}}</h5>
          <p class="text-muted small">{{this.descricao}}</p>
          <div class="d-flex gap-2">
            <a href="/admin/atividades/{{this.id}}" class="btn btn-eco-secondary btn-sm"><i class="bi bi-eye me-1"></i>Ver</a>
            <a href="/admin/atividades/{{this.id}}/editar" class="btn btn-eco-secondary btn-sm"><i class="bi bi-pencil me-1"></i>Editar</a>
          </div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="eco-card text-center p-5">
    <div style="font-size:3rem;">📋</div>
    <h5 class="mt-3 fw-bold">Nenhuma atividade pronta</h5>
    <p class="text-muted">Crie atividades template para os professores usarem.</p>
  </div>
  {{/if}}
</div>
